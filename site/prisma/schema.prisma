// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  Art
  Game
  Nature
  Sport
  Portrait
  Animal
}

enum TransactionType {
  MINT
  SALE
  RESALE
}

model User {
  id                 String        @id @default(cuid())
  walletAddress      String        @unique
  nfts               NFT[]         @relation("UserNFTs")
  listings           Listing[]     @relation("UserListings")
  transactionsBought Transaction[] @relation("BoughtTransactions")
  transactionsSold   Transaction[] @relation("SoldTransactions")
  createdAt          DateTime      @default(now())
}

model NFT {
  id          String @id @default(cuid())
  tokenId     Int    @unique
  name        String
  description String
  imageUrl    String
  metadata    String

  width  Int?
  height Int?

  owner   User   @relation("UserNFTs", fields: [ownerId], references: [id])
  ownerId String

  createdAt DateTime @default(now())

  listings     Listing?
  transactions Transaction[]
}

model Listing {
  id       String    @id @default(cuid())
  tokenId  Int       @unique
  price    String
  active   Boolean   @default(true)
  category Category?

  seller   User   @relation("UserListings", fields: [sellerId], references: [id])
  sellerId String

  createdAt DateTime @default(now())
  nft       NFT      @relation(fields: [tokenId], references: [tokenId])
}

model Transaction {
  id        String @id @default(cuid())
  tokenId   Int
  listingId String

  buyer    User   @relation("BoughtTransactions", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SoldTransactions", fields: [sellerId], references: [id])
  sellerId String

  price     String
  type      TransactionType?
  txHash    String?
  createdAt DateTime         @default(now())
  nft       NFT              @relation(fields: [tokenId], references: [tokenId])
}
