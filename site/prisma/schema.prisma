datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  Art
  Game
  Nature
  Sport
  Portrait
  Animal
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

model User {
  id                 String        @id @default(cuid())
  name               String
  walletAddress      String        @unique
  avatarUrl          String?
  balance            Float         @default(0)
  nfts               NFT[]         @relation("UserNFTs")
  listings           Listing[]     @relation("UserListings")
  transactionsBought Transaction[] @relation("BoughtTransactions")
  transactionsSold   Transaction[] @relation("SoldTransactions")
  createdAt          DateTime      @default(now())
}

model NFT {
  id              String        @id @default(cuid())
  tokenId         String
  contractAddress String
  title           String
  description    String?
  imageUrl        String // e.g. IPFS URL or your S3/Next public/img path
  metadata        Json? // any extra JSON metadata
  category        Category? // for your Filter UI
  width           Int? // e.g. 420
  height          Int? // e.g. 420
  owner           User          @relation("UserNFTs", fields: [ownerId], references: [id])
  ownerId         String
  listing        Listing?     @relation("NFTListings")
  transactions    Transaction[]  @relation("NFTTransactions")
  addedAt         DateTime      @default(now())
}

/// A “Buy Now” listing for an NFT
model Listing {
  id          String        @id @default(cuid())
  nft         NFT           @relation("NFTListings", fields: [nftId], references: [id])
  nftId       String        @unique
  seller      User          @relation("UserListings", fields: [sellerId], references: [id])
  sellerId    String
  description String?
  price       Float // Buy-Now price (e.g. 0.08 ETH)
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
}

/// A completed purchase transaction
model Transaction {
  id        String   @id @default(cuid())
  nft       NFT      @relation("NFTTransactions", fields: [nftId], references: [id])
  nftId     String
  listingId String
  buyer     User     @relation("BoughtTransactions", fields: [buyerId], references: [id])
  buyerId   String
  seller    User     @relation("SoldTransactions", fields: [sellerId], references: [id])
  sellerId  String
  price     Float // final sale price
  createdAt DateTime @default(now())
}


model Nonce {
  id     String @id @default(cuid())
  value  String @unique
  createdAt DateTime @default(now())
}
