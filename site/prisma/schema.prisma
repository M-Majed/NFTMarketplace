datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  Art
  Game
  Nature
  Sport
  Portrait
  Animal
}

enum TransactionType {
  MINT
  SALE
  RESALE
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())

  nfts               NFT[]         @relation("UserNFTs")
  listings           Listing[]     @relation("UserListings")
  transactionsBought Transaction[] @relation("BoughtTransactions")
  transactionsSold   Transaction[] @relation("SoldTransactions")
  wishlist           WishlistItem[]
}

model NFT {
  id          String   @id @default(cuid())
  tokenId     Int      @unique
  name        String
  description String
  imageUrl    String
  metadata    String
  width       Int?
  height      Int?
  size        Int?

  ownerId String
  owner   User     @relation("UserNFTs", fields: [ownerId], references: [id])

  listings     Listing?
  transactions Transaction[]

  createdAt DateTime @default(now())
}

model Listing {
  id       String   @id @default(cuid())
  tokenId  Int      @unique
  price    String
  active   Boolean  @default(true)
  category Category?

  sellerId String
  seller   User     @relation("UserListings", fields: [sellerId], references: [id])

  nft NFT @relation(fields: [tokenId], references: [tokenId])

  createdAt    DateTime      @default(now())
  wishlistedBy WishlistItem[]
}

model Transaction {
  id        String   @id @default(cuid())
  tokenId   Int
  nft       NFT      @relation(fields: [tokenId], references: [tokenId])

  listingId String

  buyerId String
  buyer   User     @relation("BoughtTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   User     @relation("SoldTransactions", fields: [sellerId], references: [id])

  price     String
  type      TransactionType?
  txHash    String?
  createdAt DateTime @default(now())
}

model WishlistItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}
